# ============================================================================
# AI Content Factory — environment template
# ============================================================================
# Copy to .env and fill in. The defaults below describe the FREE-TIER setup:
# no provider in it is billed, and only two of the keys require a signup.
#
#   Chat + embeddings + judge  Gemini free tier          GOOGLE_API_KEY
#   Web research               Tavily free tier          TAVILY_API_KEY
#                              DuckDuckGo fallback       (no key)
#   Images                     Pollinations Flux         (no key)
#   Speech                     Edge TTS                  (no key)
#   Transcription              local Whisper             (no key)
#   Video B-roll               Pexels free tier          PEXELS_API_KEY
#
# Free keys:
#   GOOGLE_API_KEY  https://aistudio.google.com/apikey
#   TAVILY_API_KEY  https://app.tavily.com          (1000 credits/month)
#   PEXELS_API_KEY  https://www.pexels.com/api/     (free forever)

# ── LLM provider ────────────────────────────────────────────────────────────
# Every chat client in this project is a `ChatOpenAI`, which is an
# OpenAI-PROTOCOL client rather than an OpenAI-only one. Pointing LLM_BASE_URL
# at another vendor's compatibility endpoint runs the entire pipeline —
# structured output included — against that vendor, with no code change.
#
# Endpoint resolution, in order:
#   1. LLM_BASE_URL set              → that endpoint
#   2. GOOGLE_API_KEY and no OPENAI_API_KEY → Google's OpenAI-compat endpoint
#   3. otherwise                     → api.openai.com
# Credential resolution: LLM_API_KEY, else the key for the chosen endpoint.
GOOGLE_API_KEY=AIzaSy-your-google-api-key-here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Leave OPENAI_API_KEY EMPTY on the free setup. Several modules read a
# non-empty value as "the OpenAI REST API is reachable" and call DALL-E,
# Whisper or TTS with it directly — so putting a Gemini key here turns an
# instant skip into a slow authentication failure on every image and every
# audio turn. It is never reused as the Gemini credential.
OPENAI_API_KEY=

# Any OpenAI-compatible endpoint (vLLM, Ollama, OpenRouter, Groq, …) works
# through the same two variables:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama

# ── Models ──────────────────────────────────────────────────────────────────
# LLM_FAST_MODEL:    router, research extraction, topic guard, campaign copy.
# LLM_QUALITY_MODEL: QA auditor, revision agent, podcast scripter, section
#                    writers, and the fallback when the UI picks no model.
#
# The two are set to DIFFERENT model ids on purpose: the free-tier quota is per
# model, so splitting them doubles the requests per minute the pipeline can
# make. Defaults follow LLM_BASE_URL (Gemini ids on Google, gpt-5-mini on
# OpenAI), so you only need these to override.
#
# Two selection rules, both learned the hard way on this tier:
#
# 1. Prefer the LITE models as the defaults. The per-day quota differs sharply
#    by model: the full `flash` models were exhausted after a single complete
#    run, while the `-lite` ones still had headroom. Availability beats a
#    marginal prose improvement you cannot demo.
# 2. Avoid the newest models. gemini-3.8/3.7-flash are the most contended — a
#    probe of 4 consecutive calls returned HTTP 503 "experiencing high demand"
#    on 2 of them, which is enough to kill a run.
#
# On a paid tier, set LLM_QUALITY_MODEL=gemini-3.6-flash for better prose.
LLM_FAST_MODEL=gemini-3.5-flash-lite
LLM_QUALITY_MODEL=gemini-3.1-flash-lite

# ── Cross-model failover ────────────────────────────────────────────────────
# The free tier also caps requests per DAY per model, and on this tier that cap
# is 20:
#
#   429 RESOURCE_EXHAUSTED
#   quotaId: GenerateRequestsPerDayPerProjectPerModel-FreeTier, quotaValue: 20
#
# One complete run makes well over thirty calls, and no amount of waiting helps
# — the budget is gone until Google's clock rolls over. But the cap is PER
# MODEL, and the endpoint serves many interchangeable ones, so a quota-blocked
# request is retried on the next model in this list. That multiplies the daily
# budget by the size of the pool.
#
# Keep aliases out: gemini-flash-latest resolves to gemini-3.5-flash and shares
# its quota, so listing both buys nothing. The gemma-* models are also absent
# on purpose — they answered HTTP 500 rather than serving. Leave empty to
# disable failover.
LLM_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3-flash-preview,gemini-3.6-flash,gemini-3.5-flash,gemini-3.7-flash

# ── Embeddings (RAG over uploaded documents) ────────────────────────────────
# Follows LLM_BASE_URL — Google's compatibility endpoint serves /embeddings
# too. DIMENSIONS is pinned because a Chroma collection fixes its vector width
# on first write: an index built at 1536 cannot accept gemini-embedding-001's
# native 3072, and the upsert fails with a dimension mismatch that silently
# costs the upload its RAG index. Change it only for a fresh index.
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536
# Google caps one embed request at 100 inputs, well below langchain-openai's
# OpenAI-shaped default batch.
# EMBEDDING_BATCH_SIZE=100

# ── Free-tier rate limiting ─────────────────────────────────────────────────
# Gemini's free tier allows 5 requests per minute PER MODEL. The orchestrator
# writes sections concurrently, so an unthrottled 7-section outline fires 7
# requests at once and everything past the fifth returns
# "429 RESOURCE_EXHAUSTED ... limit: 5". Retries do not fix it: their backoff
# is seconds while the quota window is a rolling minute, and every concurrent
# request retries into the same exhausted window.
#
# Graph/agents/utils.py therefore holds one blocking token bucket per model id.
# BURST stays at 1 (strict even spacing) because 5 at once plus one more twelve
# seconds later is still 6 inside the same minute.
#
# Set LLM_REQUESTS_PER_MINUTE=0 on a paid tier — there it is only latency.
LLM_REQUESTS_PER_MINUTE=5
LLM_RATE_LIMIT_BURST=1

# ── Web research ────────────────────────────────────────────────────────────
# Tavily first: its results carry extracted article text and a real published
# date, both of which the evidence extractor uses. Without a key (or once the
# free credits run out) the research node falls back to keyless DuckDuckGo, so
# grounding degrades to shorter snippets instead of disappearing.
TAVILY_API_KEY=tvly-your-tavily-key-here

# ── Media ───────────────────────────────────────────────────────────────────
# Pexels supplies the 9:16 B-roll for the short video. Without it the video
# agent falls back to procedurally generated backgrounds.
PEXELS_API_KEY=your-pexels-key-here

# Speech is Edge TTS (keyless, no practical rate limit), with the paid OpenAI
# tts-1-hd and then Gemini TTS as fallbacks. Voices come from
# `edge-tts --list-voices`.
# EDGE_TTS_VOICE_A=en-US-AriaNeural
# EDGE_TTS_VOICE_B=en-US-GuyNeural
# EDGE_TTS_VOICE_NARRATOR=en-US-ChristopherNeural

# Only used if Edge TTS is unavailable. Gemini's TTS free tier is a few
# requests per minute — not enough for a 20-turn podcast.
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# The image chain runs: the selected provider, then Gemini, then Pollinations,
# then a Pexels stock photo, then a locally rendered figure. A quota error never
# costs the run its illustrations.
#
# Pollinations is the only *generative* provider that is free at all — Gemini's
# image models return 429 on the free tier and DALL-E needs OpenAI credit — but
# its anonymous tier is small: after a couple of images both `turbo` and `flux`
# answer "HTTP 402 Payment Required". A 402/401/403 skips straight to the next
# model rather than retrying a paywall. POLLINATIONS_TOKEN (free registration)
# raises those limits.
#
# When generation is unavailable the chain falls back to a real Pexels
# photograph, and finally to an offline Pillow-rendered captioned figure, which
# cannot fail. A missing image renders as a broken-image icon in the UI and in
# every export, which reads as a bug — so the last link never returns nothing.
# POLLINATIONS_MODELS=turbo,flux
# POLLINATIONS_TOKEN=            # optional; unlocks flux
# Worst case per image is attempts x timeout x models, and it is spent before
# reaching the fallback that was always going to serve. 2 x 45s x 2 caps it
# at three minutes.
# POLLINATIONS_ATTEMPTS=2
# POLLINATIONS_TIMEOUT=45
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# ── Evaluation ──────────────────────────────────────────────────────────────
# LLM_JUDGE_MODEL is read ONLY by the evaluation node (in-house G-Eval and
# DeepEval). It defaults to LLM_QUALITY_MODEL.
#
# Set it to a DIFFERENT model for two reasons. Methodologically it removes
# self-preference bias — a model grading its own prose is not an independent
# judge. Practically, the free-tier quota is per model, so the judge gets its
# own budget instead of competing with the section writers.
#
# It is deliberately separate from LLM_QUALITY_MODEL so that an
# independent-judge arm does not ALSO move the QA auditor and the revision
# agent, which would confound any change in scores with a change in the text
# being scored.
LLM_JUDGE_MODEL=gemini-3-flash-preview

# deepeval sends anonymous telemetry on import unless told not to.
DEEPEVAL_TELEMETRY_OPT_OUT=YES

# ── Timeouts and retries ────────────────────────────────────────────────────
# Unset, langchain-openai inherits the SDK's 600s read timeout and retries
# twice, so one wedged request can hold a worker thread for ~30 minutes.
LLM_REQUEST_TIMEOUT=180
# 1, not the default 2. Retries and cross-model failover are alternative
# recoveries, and with LLM_FALLBACK_MODELS set, failover is the better one: the
# SDK honours Google's `retry-after`, which for a per-DAY quota error is ~37
# seconds of waiting for a budget that will not return today. Five of those per
# model, across a pool of six, stalled a single evaluation call for over seven
# minutes. One retry still absorbs a transient blip; anything worse fails over.
LLM_MAX_RETRIES=1

# ── Cost reporting ──────────────────────────────────────────────────────────
# Estimates use published list prices recorded in Agents_backend/usage.py.
# Gemini ids are recorded at 0.00 there because this setup runs them on the
# free tier — a $0.00 total means "free tier", not "price unknown"; the report
# says which. Override any model with USD per 1,000,000 tokens as
# "input,output":
# LLM_PRICE_GEMINI_3_5_FLASH=0.30,2.50
# LLM_PRICE_GPT_5_MINI=0.25,2.00

# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL when using Docker / Postgres; leave empty for SQLite.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_content_factory

# ── API access control (both optional; unset = open, fine on localhost) ─────
# API_KEY: when set, callers must send it as the X-API-Key header. The frontend
#          reads the same value from VITE_API_KEY (see frontend/.env.example).
# API_KEY=choose-a-long-random-string
# ALLOWED_ORIGINS: comma-separated CORS allowlist. Defaults to the local Vite
#                  dev server origins. Use "*" only for a throwaway demo.
# ALLOWED_ORIGINS=http://localhost:3000

# ── ChromaDB vector store (optional) ────────────────────────────────────────
# CHROMA_API_KEY / CHROMA_TENANT / CHROMA_DATABASE select Chroma Cloud. With no
# API key the store falls back to a local persistent index on disk.
# CHROMA_PERSIST_DIR sets where that local index lives. An ABSOLUTE path is used
# as given; a RELATIVE one is resolved against the Agents_backend directory, not
# the shell's working directory — so the index is the same whether the server is
# started from the repo root or from Agents_backend/. Default:
# Agents_backend/data/chroma_db
# CHROMA_PERSIST_DIR=data/chroma_db

# ── Other optional integrations ─────────────────────────────────────────────
# HF_TOKEN=hf_your-huggingface-token-here
# FIRECRAWL_API_KEY=fc-your-firecrawl-key-here
# TWITTER_API_KEY=your-twitter-api-key-here
